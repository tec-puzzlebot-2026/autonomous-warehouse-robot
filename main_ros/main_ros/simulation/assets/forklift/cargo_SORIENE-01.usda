#usda 1.0
(
    defaultPrim = "Box"
    metersPerUnit = 1
    upAxis = "Z"
    doc = """The teammate's box (cargo.usdc) with QR SORIENE-01 on its pick face (y = 0,
    facing -y, 1 mm off the carton). To move the QR to another face, change the
    translate/rotate of Box/QR. Generated by simulation/scripts/make_qr_assets.py."""
)

def Xform "Box" (
    prepend references = @./cargo.usdc@
)
{
    def "QR" (
        prepend references = @../qr/qr_plate_SORIENE-01.usda@
    )
    {
        double3 xformOp:translate = (0.06, -0.001, 0.0775)
        float xformOp:rotateZ = -90
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
    }
}
