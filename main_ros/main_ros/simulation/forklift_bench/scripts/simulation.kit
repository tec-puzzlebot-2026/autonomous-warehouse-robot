[package]
title = "Simulación PuzzleBot"
version = "0.1.0"

[dependencies]
"omni.pip.compute" = {}
"omni.physx" = {}
"omni.physx.tensors" = {}
"omni.physx.fabric" = {}
"omni.usd" = {}

[settings]
app.window.enabled = false
app.renderer.enabled = false
app.file.ignoreUnsavedOnExit = true
app.fastShutdown = true
app.extensions.registryEnabled = false
