#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    custom bool measuredPuzzlebotGeometry = 1

    def PhysicsScene "Physics" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        uniform token physxScene:broadphaseType = "MBP"
        bool physxScene:enableGPUDynamics = 0
        uint physxScene:timeStepsPerSecond = 120
    }

    def Cube "Floor" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </World/FloorContact>
        float physxCollision:contactOffset = 0.0006
        float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.5, 0.52, 0.53)]
        double size = 1
        float3 xformOp:scale = (2.12, 1.26, 0.05)
        double3 xformOp:translate = (0, 0, -0.025)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Material "FloorContact" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.65
        float physics:restitution = 0
        float physics:staticFriction = 0.85
    }

    def Cube "CenterDivider" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        float physxCollision:contactOffset = 0.0006
        float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.43, 0.49, 0.54)]
        double size = 1
        float3 xformOp:scale = (0.016, 1.26, 0.42)
        double3 xformOp:translate = (-0.348, 0, 0.21)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def DomeLight "AmbientLight"
    {
        float inputs:intensity = 650
    }

    def DistantLight "KeyLight"
    {
        float inputs:angle = 18
        float inputs:intensity = 1300
        float3 xformOp:rotateXYZ = (28, -20, -35)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def "Sets"
    {
        def Xform "Set_00"
        {
            custom string scenario = "floor"
            custom double spawnForkGap = 0.12
            custom double spawnLateralOffset = 0
            custom double spawnYawOffsetDegrees = 0
            custom double supportHeight = 0.02

            def "Rack"
            {
                def Cube "Post_0_0" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
                )
                {
                    float physxCollision:contactOffset = 0.0006
                    float physxCollision:restOffset = 0
                    color3f[] primvars:displayColor = [(0.06, 0.2, 0.69)]
                    double size = 1
                    float3 xformOp:scale = (0.01, 0.01, 0.22)
                    double3 xformOp:translate = (0.34500000000000003, -0.16999999999999998, 0.11)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "Post_0_2" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
                )
                {
                    float physxCollision:contactOffset = 0.0006
                    float physxCollision:restOffset = 0
                    color3f[] primvars:displayColor = [(0.06, 0.2, 0.69)]
                    double size = 1
                    float3 xformOp:scale = (0.01, 0.01, 0.22)
                    double3 xformOp:translate = (0.34500000000000003, 0.16999999999999998, 0.11)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "Post_2_0" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
                )
                {
                    float physxCollision:contactOffset = 0.0006
                    float physxCollision:restOffset = 0
                    color3f[] primvars:displayColor = [(0.06, 0.2, 0.69)]
                    double size = 1
                    float3 xformOp:scale = (0.01, 0.01, 0.22)
                    double3 xformOp:translate = (0.445, -0.16999999999999998, 0.11)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "Post_2_2" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
                )
                {
                    float physxCollision:contactOffset = 0.0006
                    float physxCollision:restOffset = 0
                    color3f[] primvars:displayColor = [(0.06, 0.2, 0.69)]
                    double size = 1
                    float3 xformOp:scale = (0.01, 0.01, 0.22)
                    double3 xformOp:translate = (0.445, 0.16999999999999998, 0.11)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "Back" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
                )
                {
                    float physxCollision:contactOffset = 0.0006
                    float physxCollision:restOffset = 0
                    color3f[] primvars:displayColor = [(0.43, 0.49, 0.54)]
                    double size = 1
                    float3 xformOp:scale = (0.01, 0.35, 0.22)
                    double3 xformOp:translate = (0.45, 0, 0.11)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "Shelf_0" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
                )
                {
                    float physxCollision:contactOffset = 0.0006
                    float physxCollision:restOffset = 0
                    color3f[] primvars:displayColor = [(0.72, 0.035, 0.035)]
                    double size = 1
                    float3 xformOp:scale = (0.11, 0.35, 0.01)
                    double3 xformOp:translate = (0.395, 0, 0.015)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "Shelf_1" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
                )
                {
                    float physxCollision:contactOffset = 0.0006
                    float physxCollision:restOffset = 0
                    color3f[] primvars:displayColor = [(0.72, 0.035, 0.035)]
                    double size = 1
                    float3 xformOp:scale = (0.11, 0.35, 0.01)
                    double3 xformOp:translate = (0.395, 0, 0.195)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }
            }

            def Cube "Screen" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                float physxCollision:contactOffset = 0.0006
                float physxCollision:restOffset = 0
                color3f[] primvars:displayColor = [(0.43, 0.49, 0.54)]
                double size = 1
                float3 xformOp:scale = (0.53, 0.012, 0.42)
                double3 xformOp:translate = (0.605, 0.3, 0.21)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Xform "Load" (
                prepend references = @../../assets/forklift/cargo.usdc@
            )
            {
                float xformOp:rotateZ:placement = 90
                double3 xformOp:translate:placement = (0.44, -0.06, 0.0204)
                uniform token[] xformOpOrder = ["xformOp:translate:placement", "xformOp:rotateZ:placement"]
            }

            def Xform "Robot" (
                prepend references = @../../assets/forklift/puzzlebot_forklift.usdc@
            )
            {
                float xformOp:rotateZ:placement = 0
                double3 xformOp:translate:placement = (-0.011919999999999958, 0, 0.0025)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:translate:placement", "xformOp:rotateZ:placement"]
            }

            def Cube "DropMark"
            {
                color3f[] primvars:displayColor = [(0.78, 0.59, 0.1)]
                double size = 1
                float3 xformOp:scale = (0.14, 0.15, 0.0003)
                double3 xformOp:translate = (0.18200000000000002, 0, 0.00015)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }
    }
}

