  </joint>
  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_base_link"/>
    <child link="laser_frame"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.00 0.035"/>
  </joint>
  <!--<gazebo reference='${prefix}lidar_base_joint'>
    <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <gazebo reference='${prefix}lidar_joint'>
    <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>-->
  <gazebo reference="laser_frame">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id></gz_frame_id>
      <pose> 0 0 0 0 0 0 </pose>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>6.283185</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>0.01</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.017</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="libDiffDynamicPlugin.so" name="DiffDynamicPlugin">
      <leftJoint>wheel_left_joint</leftJoint>
      <rightJoint>wheel_right_joint</rightJoint>
      <cmd_R_topic>VelocitySetR</cmd_R_topic>
      <cmd_L_topic>VelocitySetL</cmd_L_topic>
      <cmd_vel_topic>cmd_vel</cmd_vel_topic>
      <enc_R_topic>VelocityEncR</enc_R_topic>
      <enc_L_topic>VelocityEncL</enc_L_topic>
      <robot_vel_topic>robot_vel</robot_vel_topic>
      <mot_Vmax>5</mot_Vmax>
      <mot_J>0.0005</mot_J>
      <mot_R>2</mot_R>
      <mot_L>0.01</mot_L>
      <mot_K>0.01</mot_K>
      <mot_b>0.00001</mot_b>
      <mot_gear>34</mot_gear>
      <robot_width>0.19</robot_width>
      <wheel_radius>0.05</wheel_radius>
      <pid_Kp>0.1</pid_Kp>
      <pid_Ti>0.05</pid_Ti>
      <pid_Td>0</pid_Td>
      <input_type>1</input_type>
      <rate>100</rate>
    </plugin>
    <!--<plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <odom_publisher_frequency>50</odom_publisher_frequency>
