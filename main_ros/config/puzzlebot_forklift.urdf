<?xml version="1.0"?>
<!--
  puzzlebot_forklift.urdf — the forklift PuzzleBot in Isaac Sim, simple shapes
  Published on /robot_description by robot_state_publisher (step "robot_description"
  in program_manager.yaml, sim mode: urdf_file). Gives TF base_link -> laser_frame
  (SLAM, Sendero), camera_link / camera_optical_frame (pick_back finds the box in the
  image) and the two IR frames.

  base_link: on the floor, under the middle of the wheel axle, x forward (our
  convention). The numbers come from the teammate's model
  (simulation/assets/forklift/puzzlebot_forklift.usdc), whose base_footprint lies
  0.052 m behind the axle: every x below is "his x - 0.052".
    wheels   radius 0.05, 0.085 m to each side (track 0.17)
    LiDAR    x -0.0095, z 0.155
    camera   x 0.0939,  z 0.235, pitched 17.5 deg down
    IR       x 0.0933,  y +-0.044, z 0.0555 (facing forward, under the forks)
    forks    tips 0.180 m ahead of the axle (pick_sim.json fork_reach_m)
  Author: Raymundo Gomez
-->
<robot name="puzzlebot_forklift">

  <material name="chassis"><color rgba="0.15 0.15 0.18 1.0"/></material>
  <material name="wheel"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="lidar"><color rgba="0.10 0.45 0.85 1.0"/></material>
  <material name="caster"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="front"><color rgba="0.95 0.55 0.10 1.0"/></material>
  <material name="fork"><color rgba="0.75 0.75 0.78 1.0"/></material>

  <link name="base_link"/>

  <link name="chassis_link">
    <visual>
      <origin xyz="-0.03 0 0" rpy="0 0 0"/>
      <geometry><box size="0.20 0.16 0.04"/></geometry>
      <material name="chassis"/>
    </visual>
  </link>
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

  <!-- the forks, drawn at the bottom (the lift height is in /joint_states) -->
  <link name="forks_link">
    <visual>
      <origin xyz="0 0.035 0" rpy="0 0 0"/>
      <geometry><box size="0.10 0.02 0.006"/></geometry>
      <material name="fork"/>
    </visual>
    <visual>
      <origin xyz="0 -0.035 0" rpy="0 0 0"/>
      <geometry><box size="0.10 0.02 0.006"/></geometry>
      <material name="fork"/>
    </visual>
  </link>
  <joint name="forks_joint" type="fixed">
    <parent link="base_link"/>
    <child link="forks_link"/>
    <origin xyz="0.13 0 0.003" rpy="0 0 0"/>
  </joint>

  <link name="front_marker_link">
    <visual>
      <geometry><box size="0.01 0.14 0.012"/></geometry>
      <material name="front"/>
    </visual>
  </link>
  <joint name="front_marker_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="front_marker_link"/>
    <origin xyz="0.07 0 0.026" rpy="0 0 0"/>
  </joint>

  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.025"/></geometry>
      <material name="wheel"/>
    </visual>
  </link>
  <joint name="wheel_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0 0.085 0.05" rpy="0 0 0"/>
  </joint>

  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.025"/></geometry>
      <material name="wheel"/>
    </visual>
  </link>
  <joint name="wheel_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0 -0.085 0.05" rpy="0 0 0"/>
  </joint>

  <link name="caster_link">
    <visual>
      <geometry><sphere radius="0.015"/></geometry>
      <material name="caster"/>
    </visual>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="-0.13 0 0.015" rpy="0 0 0"/>
  </joint>

  <!-- 2D LiDAR: the frame of /laser_scan (the OmniLidar sits at his laser_frame) -->
  <link name="laser_frame">
    <visual>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="lidar"/>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="-0.0095 0 0.155" rpy="0 0 0"/>
  </joint>

  <!-- camera: camera_link x forward, pitched down; optical frame z forward, x right, y down -->
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.0939 0 0.235" rpy="0 0.3054 0"/>
  </joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- IR distance sensors under the forks (x forward) -->
  <link name="forklift_ir_left_optical_frame"/>
  <joint name="forklift_ir_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="forklift_ir_left_optical_frame"/>
    <origin xyz="0.0933 0.044 0.0555" rpy="0 0 0"/>
  </joint>
  <link name="forklift_ir_right_optical_frame"/>
  <joint name="forklift_ir_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="forklift_ir_right_optical_frame"/>
    <origin xyz="0.0933 -0.044 0.0555" rpy="0 0 0"/>
  </joint>

</robot>
